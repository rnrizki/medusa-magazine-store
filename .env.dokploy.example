# --- Security Secrets ---
JWT_SECRET=7c605cb37da6e3fad6e91d41bf0dee10a861b7c15f5d31dcd1881ddd6694a858
COOKIE_SECRET=fbe9788a9f1534c9c6882e8ba194ff7f3d9f752b43e486a6de007a35d6029150

# --- Domain & URL Setup ---
