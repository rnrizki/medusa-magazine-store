# Medusa Backend & Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa_db
POSTGRES_PORT=5432

# Medusa v2 Database connection string
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa_db
REDIS_URL=redis://redis:6379

# JWT & Cookie secrets
JWT_SECRET=supersecret_jwt_key_medusa_ecommerce_2026
COOKIE_SECRET=supersecret_cookie_key_medusa_ecommerce_2026

# Default Admin User credentials
MEDUSA_ADMIN_EMAIL=admin@medusa-store.com
MEDUSA_ADMIN_PASSWORD=supersecret
SEED_DB=true

# CORS Configurations
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:8000,http://localhost:3000,http://localhost:9000

# Storefront Configurations
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_BACKEND_URL=http://backend:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_medusa_default_key
PORT=8000

# S3 Storage for Pictures & Heavy Files (AWS S3, Cloudflare R2, MinIO, Wasabi)
S3_BUCKET=your-magazine-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.yourdomain.com
S3_FORCE_PATH_STYLE=false
GEMINI_API_KEY=your_gemini_api_key_here
